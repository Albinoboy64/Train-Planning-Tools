thin","top":"thin","bottom":"thin"},"numFmt":0,"h":"center","v":"top","wrap":true},{"sz":13.0,"b":false,"fill":null,"border":{"top":"thin","bottom":"thin"},"numFmt":0,"h":"center","v":"top","wrap":true},{"sz":13.0,"b":false,"fill":null,"border":{"right":"thin","top":"thin","bottom":"thin"},"numFmt":4,"h":"center","v":"top","wrap":true},{"sz":13.0,"b":false,"fill":null,"border":{"right":"thin","top":"thin","bottom":"thin"},"numFmt":0,"h":"center","v":"top","wrap":true},{"sz":13.0,"b":false,"fill":null,"border":{},"numFmt":4,"h":"center","v":"top","wrap":true},{"sz":13.0,"b":false,"fill":null,"border":{"left":"thin","top":"thin","bottom":"thin"},"numFmt":4,"h":"center","v":"top","wrap":true},{"sz":13.0,"b":false,"fill":null,"border":{"top":"thin","bottom":"thin"},"numFmt":4,"h":"center","v":"top","wrap":true},{"sz":13.0,"b":false,"fill":null,"border":{"left":"thin"},"numFmt":4,"h":"center","v":"top","wrap":true},{"sz":13.0,"b":false,"fill":null,"border":{"left":"thin","bottom":"thin"},"numFmt":4,"h":"center","v":"top","wrap":true},{"sz":13.0,"b":false,"fill":null,"border":{"bottom":"thin"},"numFmt":4,"h":"center","v":"top","wrap":true},{"sz":13.0,"b":false,"fill":null,"border":{"right":"thin","bottom":"thin"},"numFmt":4,"h":"center","v":"top","wrap":true}],"sheets":[{"name":"Glossary","cols":[[1,1,15.0],[2,2,100.0]],"merges":[],"title":[[1,null,{"$":0}]],"header":[[[1,"Created (version)",{"$":1}],[2,"Rolling Stock Input File",{"$":2}]]],"body":{"1":{"$":3},"2":{"$":4}},"last":{"1":{"$":5},"2":{"$":6}},"styles":{"r2":[{"$":1},{"$":2}],"r3":[{"$":3},{"$":4}],"blank":[{"$":7},{"$":7}],"section":[{"$":8},{"$":6}],"item":[{"$":5},{"$":6}]},"text":[[null,null],["General Glossary",null],["Headcode:","A 4 character identifier for a train e.g. 1V07. The 1st character identifies service class. The 2nd is a letter that can be used to designate the direction of trains within an area and the 3rd and 4th are numbers to make a service individual within its time period.\n\nService class list (first character):\n0-Light Locos/Buses/Ships\n1-Express Passenger/Express Parcel/Test Trains/Charter Services\n2-Ordinary Passenger\n3-Express Freight/Parcels/Test Trains/ECS permitted to run at more than 75 mph\n4-Freight train permitted to run at more than 60 mph\n5-Empty Coaching Stock\n6-Freight service permitted to run at 50-55 or 60mph\n7-Freight service permitted to run at 40-45 mph\n8-Freight Service permitted to run at a maximum speed of 35mph\n9-Eurostar/certain Cross Country services and specific TOC trains"],["Service:","Loaded or empty service from origin to destination identified with a 4 character headcode. Also referred to as a formation."],["ECS/Empty Coaching Stock:","A non passenger service from A-B usually labelled as a class 5xxx headcode but can be class 3xxx for high priority ECS moves."],["Service Code:","An 8 digit code that each train must contain and correlates with the route the train operates over. Some trains have more than one if they traverse several routes or areas."],["Vehicle:","The component parts of a unit. Usually the total number of carriages and locos. Edit this value in the Fleet tab."],["Unit:","A form of traction that comprises of between 1 and X vehicles."],["Formation:","The combined type(s) of single or multiple units that operate as a service."],["Examples of units and formations:","144/1 operating alone is both a unit and formation.\n144/1+150/1 is a 144/1 unit operating on a service with a 150/1 unit creating a 144/1+150/1 formation for that service.\nHST 2+7  is a unit and formation that consists of 2 HST power cars and 7 coaches."],["Diagram:","The work an individual unit undertakes each day. This contains the services it works with the headcodes, and any interaction it has on these trains with other units i.e. making a formation."],["Fleet/Stock:","A way of defining the class of unit e.g. 144/1 or 150/0. These are generally defined by painted number."],[null,null],["Tab Glossary",null],["Fleet:","An overview of the stock types used in this solution and their capacities."],["Service Miles:","The mileage for each individual service train in the model. This is defined by headcode and an origin and destination with a total mileage for this service.  This tab also contains the same data for ECS moves. Each row would constitute a leg of an individual units diagram."],["Service Count by Formation:","How many services each formation of units within the stock model work divided between service trains and ECS moves with an overall total. \"?\" indicates stock type is unknown."],["Mileage by Formation:","How many miles each formation of units within the model cover per day divided between service trains and ECS moves with an overall total. \"?\" indicates stock type is unknown."],["Mileage by Unit:","How many miles each unit covers per day, summed up by fleet type. \"?\" indicates stock type is unknown."],["Mileage by Vehicle:","The mileage each vehicle that forms a unit covers per day, by fleet type. TRACS-RS must have each stock type's number of vehicles manually entered for this information to be calculated. \"?\" indicates stock type is unknown."],["Formation Mileage by Service Code:","Each formation of units' daily mileage against Train Service Codes within the whole timetable. \"?\" indicates stock type is unknown."],["Unit Mileage by Service Code:","Each unit fleet's daily mileage against Train Service Codes within the whole timetable. \"?\" indicates stock type is unknown."],["Vehicle Mileage by Service Code:","The daily mileage totalled for individual vehicles of each stock type, against Train Service Codes, within the whole timetable. \"?\" indicates stock type is unknown."],["Diagrammed Time by Formation:","The amount of timetabled train time a formation by stock is in operation per day. This time does not include down time in a depot or station where a train terminates and the formation forms a new train onwards. \"?\" indicates stock type is unknown."],["Diagrammed Time by Unit:","The amount of timetabled service time a unit by stock is in operation for a day. This time does not include down time in a depot or station where a train terminates and the formation form a new train onwards. \"?\" indicates stock type is unknown."],["Diagrammed Time by Vehicle:","Diagrammed time by unit, multiplied by the car count of each stock type - giving the value per vehicle. This time does not include down time in a depot or station where a train terminates and the formation form a new train onwards. \"?\" indicates stock type is unknown."],["Wheel Turning Time by Formation:","The amount of wheel turning time a formation by stock is in operation per day. \"?\" indicates stock type is unknown."],["Wheel Turning Time by Unit:","The amount of wheel turning time a unit by stock is in operation for a day. \"?\" indicates stock type is unknown."],["Wheel Turning Time by Vehicle:","Wheel turning time time by unit, multiplied by the car count of each stock type - giving the value per vehicle. \"?\" indicates stock type is unknown."],["Vehicle Stops by Service Code:","The number of vehicles stopping at each location. Note this is calculated per service. e.g. Vehicles which arrive at a location as 1A01, terminate, and then depart as 1C01, will be counted twice. In the case of a train which changes service code, the changeover stop will be counted under both service codes, but only once in the total. \"?\" indicates stock type is unknown for a unit that stops at the location. "],["Vehicle Counts at Stops:","The number of vehicles, arriving, departing, stabled or dwelling at each location on the network, broken down hour-by-hour. \"??\" indicates stock type or cars per unit is unknown for a unit that stops at the location. "],["Vehicle Counts at Stops by Peak Times:","The number of vehicles arriving, departing or stabled at each location on the network, broken down by peaks. \"??\" indicates stock type or cars per unit is unknown for a unit that stops at the location. "],["Calling Pattern (stops+passes):","The number of services grouped by origin, destination and all timed points."],["Calling Pattern (stops only):","The number of services grouped by origin, destination and all passenger calling points."],["Diagram Summary:","Each individual units diagram number, its origin and destination with total mileage and time running stats with an overall total per fleet."],["Formation Data:","Each individual service listed by headcode and formation. A service is broken into multiple lines when the (ordered) formation of units changes: i.e. after an en-route attach or detach, or when a multi-unit formation reverses and the leading unit changes."],["Diagram Data:","Each individual service listed by headcode, with service code, origin/destination, arr/dep times and what unit works the train, with associated diagram number. Where a train formation is worked by more than one unit, the train will have two (or more) entries."]]},{"name":"Fleet","cols":[[1,1,11.0],[2,2,8.0],[3,3,8.0],[4,4,12.0],[5,5,12.0],[6,6,12.0],[7,7,12.0],[8,8,8.0],[9,9,8.0],[10,10,8.0],[11,11,8.0],[12,12,8.0],[13,13,8.0]],"merges":[],"title":[[1,"Fleet",{"$":0}]],"header":[[[1,"Class Name",{"$":9}],[2,"Power Type",{"$":10}],[3,"Vehicles per Unit",{"$":2}],[4,"First Class Seated Capacity",{"$":10}],[5,"Standard Class Seated Capacity",{"$":10}],[6,"Standing Capacity",{"$":10}],[7,"Total Capacity (excl. First Class)",{"$":2}],[8,"Units Available",{"$":10}],[9,"Units In Use",{"$":10}],[10,"Spare Units",{"$":2}],[11,"Vehicles Available",{"$":10}],[12,"Vehicles In Use",{"$":10}],[13,"Spare Vehicles",{"$":2}]]],"body":{"1":{"$":11},"2":{"$":7},"3":{"$":12},"4":{"$":7},"5":{"$":7},"6":{"$":7},"7":{"$":12},"8":{"$":7},"9":{"$":7},"10":{"$":12},"11":{"$":7},"12":{"$":7},"13":{"$":12}},"last":{"1":{"$":13},"2":{"$":14},"3":{"$":4},"4":{"$":14},"5":{"$":14},"6":{"$":14},"7":{"$":4},"8":{"$":14},"9":{"$":14},"10":{"$":4},"11":{"$":14},"12":{"$":14},"13":{"$":4}}},{"name