__pycache__/
*.pyc
build/
dist/
*.spec
!packaging/TrainPlanningTools.spec
.venv/
# Never commit real planning data, wherever it appears. The patterns ignore letter case (a.XML, b.XLSX...),
# since commits made on Linux match case-sensitively.
# Excel workbooks and templates (.xlsx .xls .xlsb .xlsm .xltx .xltm ...)
*.[xX][lL]*
# Word documents (.docx .doc .docm ...)
*.[dD][oO][cC]*
*.[xX][mM][lL]
*.[pP][dD][fF]
# train lists exported as CSV; only the app's own built-in tables (by name) are kept
*.[cC][sS][vV]
!rstools/berthing/berth_locations_default.csv
!rstools/statspack/depots_default.csv
!rstools/statspack/fleet_default.csv
!rstools/statspack/groups_default.csv
!rstools/statspack/service_groups_default.csv
!rstools/statspack/stabling_default.csv
!rstools/statspack/trent_names.csv
!rstools/timetable/tiplocs.csv
# a CIF can be saved as .txt (the app reads it): text files are ignored too, apart from the app's own
*.[tT][xX][tT]
!requirements.txt
!packaging/*-requirements.txt
!rstools/assets/THIRD_PARTY_NOTICES.txt
# Explicitly keep the sample template used by the app.
!rstools/timetable/template.xlsx
# a tiny made-up workbook (no real data) for the .xls reader test
!tests/fixtures/synthetic_cwn.xls
# Never commit local app data or generated smoke-test inputs/outputs.
TrainPlanningTools-data/
smoke/
version_info.txt
*.log
*.zip

# Attune VPT / PIF / CIF / MCA exports (real timetable data)
*.[vV][pP][tT]
*.[cC][iI][fF]
*.[mM][cC][aA]
*.[pP][iI][fF]

# coverage and release-build outputs
.coverage
.coverage.*
coverage.xml
htmlcov/
TrainPlanningTools.cdx.json
SHA256SUMS.txt
